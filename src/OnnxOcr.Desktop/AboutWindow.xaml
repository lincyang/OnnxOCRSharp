<Window x:Class="OnnxOcr.Desktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 OnnxOCRSharp"
        Width="640"
        SizeToContent="Height"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F7F8FA"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="OnnxOCRSharp Desktop"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1F2A44" />
            <TextBlock Text="{Binding VersionLabel}"
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,6,0,0" />
            <TextBlock Text="作者：程序员Linc"
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Intro -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding IntroText}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="22"
                       Foreground="#374151" />
        </Border>

        <!-- Mini program tip -->
        <Border Grid.Row="2"
                Background="#F0F7FF"
                BorderBrush="#D6E6FF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding MiniProgramIntro}"
                       TextWrapping="Wrap"
                       FontSize="12.5"
                       LineHeight="20"
                       Foreground="#1E3A5F" />
        </Border>

        <!-- QR codes -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="微信公众号"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#1F2A44"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="程序员Linc"
                               FontSize="12"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,8" />
                    <Image Source="pack://application:,,,/Assets/wechat-qrcode.jpg"
                           Width="168"
                           Height="168"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="微信扫码关注"
                               FontSize="11"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,8" />
                    <Button Content="复制公众号名称"
                            Height="30"
                            HorizontalAlignment="Center"
                            Padding="12,0"
                            Click="OnCopyWeChatClick" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="推荐小程序"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#1F2A44"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="程序员Linc表格识别"
                               FontSize="12"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,8" />
                    <Image Source="pack://application:,,,/Assets/miniprogram-table-ocr-qrcode.jpg"
                           Width="168"
                           Height="168"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="微信扫码打开"
                               FontSize="11"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,8" />
                    <Button Content="复制小程序名称"
                            Height="30"
                            HorizontalAlignment="Center"
                            Padding="12,0"
                            Click="OnCopyMiniProgramClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Links -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock HorizontalAlignment="Center">
                <Run Text="开源仓库：" Foreground="#6B7280" />
                <Run Text="github.com/lincyang/OnnxOCRSharp"
                     Foreground="#2563EB"
                     TextDecorations="Underline"
                     Cursor="Hand"
                     MouseLeftButtonUp="OnOpenGitHubClick" />
            </TextBlock>
            <TextBlock Text="Apache License 2.0"
                       FontSize="12"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Button Grid.Row="5"
                Content="关闭"
                Width="96"
                Height="34"
                HorizontalAlignment="Center"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
