<Window x:Class="OnnxOcr.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnnxOcr.Desktop.Controls"
        xmlns:vm="clr-namespace:OnnxOcr.Desktop.ViewModels"
        Title="OnnxOCRSharp Desktop"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="640"
        Background="#F3F3F3"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Window.Resources>
        <Style x:Key="QueueStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#E8E8E8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:QueueItemStatus.Running}">
                    <Setter Property="Background" Value="#FFF3CD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:QueueItemStatus.Succeeded}">
                    <Setter Property="Background" Value="#D4EDDA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:QueueItemStatus.Failed}">
                    <Setter Property="Background" Value="#F8D7DA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="模型:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#333333" />
                    <ComboBox ItemsSource="{Binding PresetOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Preset"
                              SelectedValue="{Binding SelectedPreset}"
                              Width="150"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0" />
                    <TextBlock Text="设备:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#333333" />
                    <ComboBox ItemsSource="{Binding DeviceOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Device"
                              SelectedValue="{Binding SelectedDevice}"
                              Width="72"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,10,0" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="GPU:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="#333333" />
                        <ComboBox ItemsSource="{Binding GpuDevices}"
                                  SelectedValue="{Binding SelectedGpuDevice}"
                                  SelectedValuePath="."
                                  DisplayMemberPath="DisplayLabel"
                                  Width="180"
                                  Height="28"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,10,0" />
                    </StackPanel>
                    <Button Content="添加文件"
                            Width="88"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding AddFilesCommand}"
                            ToolTip="支持一次选择多张图片" />
                    <Button Content="添加文件夹"
                            Width="96"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding AddFolderCommand}" />
                    <Button Content="开始识别"
                            Width="88"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding RecognizeCommand}" />
                    <Button Content="停止"
                            Width="64"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding CancelOperationCommand}" />
                    <Button Content="复制当前"
                            Width="88"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding CopyAllCommand}" />
                    <Button Content="复制全部"
                            Width="88"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding CopyBatchCommand}"
                            ToolTip="按文件名分组复制全部识别结果" />
                    <Button Content="导出"
                            Width="64"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding ExportResultsCommand}" />
                    <Button Content="移除"
                            Width="64"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding RemoveSelectedCommand}" />
                    <Button Content="清空"
                            Width="64"
                            Height="32"
                            Margin="0,0,6,0"
                            Command="{Binding ClearCommand}" />
                    <Button Content="关于"
                            Width="64"
                            Height="32"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="版本信息、公众号与小程序二维码" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           Text="{Binding StatusMessage}"
                           Margin="16,0,0,0"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- File queue -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="文件队列"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding QueueSummary}"
                               Foreground="#888888"
                               FontSize="12"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding QueueItems}"
                             SelectedItem="{Binding SelectedQueueItem}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="#C0392B"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:QueueItemStatus.Failed}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource QueueStatusBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Foreground="#333333" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2"
                               Text="拖拽图片/文件夹到此处&#x0a;或点击「添加文件」"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQueueItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Grid.Row="3"
                                 Height="6"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BatchProgress}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Border>

            <!-- Image preview -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <controls:ImageCanvas PreviewImage="{Binding PreviewImage}"
                                          Lines="{Binding Lines}" />
                    <TextBlock Text="请添加图片"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#999999"
                               FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="识别结果"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Lines}"
                             SelectedItem="{Binding SelectedLine}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="Wrap"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding ScoreText, StringFormat=置信度: {0}}"
                                               Foreground="#888888"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl + 滚轮缩放"
                               Foreground="#999999"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <TextBlock Text="公众号："
                               Foreground="#888888"
                               VerticalAlignment="Center" />
                    <TextBlock Text="程序员Linc"
                               Foreground="#2563EB"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               ToolTip="打开关于，查看二维码"
                               MouseLeftButtonUp="OnWeChatPromoClick" />
                </StackPanel>
                <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                <Condition Binding="{Binding NeedsDownload}" Value="False" />
                                <Condition Binding="{Binding IsBatchRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Download overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="White"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360">
                <StackPanel>
                    <TextBlock Text="正在下载模型"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Maximum="100"
                                 Width="320"
                                 Height="8" />
                    <TextBlock Text="{Binding DownloadStatus}"
                               Foreground="#666666"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,16"
                               TextWrapping="Wrap"
                               MaxWidth="320" />
                    <Button Content="取消"
                            Width="80"
                            Height="28"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelOperationCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Download prompt overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsDownload}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="White"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380">
                <StackPanel>
                    <TextBlock Text="模型文件未找到"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="当前选择的模型尚未安装。"
                               Foreground="#666666"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"
                               MaxWidth="340" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="从魔塔下载"
                                Width="110"
                                Height="32"
                                Margin="0,0,12,0"
                                Command="{Binding DownloadModelCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadSupported}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="知道了"
                                Width="80"
                                Height="32"
                                IsCancel="True"
                                Command="{Binding DismissDownloadPromptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
