<Window x:Class="OnnxOcr.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnnxOcr.Desktop.Controls"
        Title="OnnxOCR Desktop"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="模型:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#333333" />
                    <ComboBox ItemsSource="{Binding PresetOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Preset"
                              SelectedValue="{Binding SelectedPreset}"
                              Width="160"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,12,0" />
                    <TextBlock Text="设备:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#333333" />
                    <ComboBox ItemsSource="{Binding DeviceOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Device"
                              SelectedValue="{Binding SelectedDevice}"
                              Width="80"
                              Height="28"
                              VerticalContentAlignment="Center"
                              Margin="0,0,12,0" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="GPU:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="#333333" />
                        <ComboBox ItemsSource="{Binding GpuDevices}"
                                  SelectedValue="{Binding SelectedGpuDevice}"
                                  SelectedValuePath="."
                                  DisplayMemberPath="DisplayLabel"
                                  Width="200"
                                  Height="28"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0" />
                    </StackPanel>
                    <Button Content="选择图片"
                            Width="96"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding OpenImageCommand}" />
                    <Button Content="开始识别"
                            Width="96"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding RecognizeCommand}" />
                    <Button Content="停止"
                            Width="72"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding CancelOperationCommand}" />
                    <Button Content="复制全部"
                            Width="96"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding CopyAllCommand}" />
                    <Button Content="清空"
                            Width="72"
                            Height="32"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Image preview -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <controls:ImageCanvas PreviewImage="{Binding PreviewImage}"
                                          Lines="{Binding Lines}" />
                    <TextBlock Text="请选择图片"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#999999"
                               FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="识别结果"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Lines}"
                             SelectedItem="{Binding SelectedLine}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="Wrap"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding ScoreText, StringFormat=置信度: {0}}"
                                               Foreground="#888888"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock Text="Ctrl + 滚轮缩放图片"
                           DockPanel.Dock="Right"
                           Foreground="#999999" />
                <TextBlock Text="{Binding ElapsedText}" />
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                <Condition Binding="{Binding NeedsDownload}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Download overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="White"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360">
                <StackPanel>
                    <TextBlock Text="正在下载模型"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Maximum="100"
                                 Width="320"
                                 Height="8" />
                    <TextBlock Text="{Binding DownloadStatus}"
                               Foreground="#666666"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,16"
                               TextWrapping="Wrap"
                               MaxWidth="320" />
                    <Button Content="取消"
                            Width="80"
                            Height="28"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelOperationCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Download prompt overlay -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsDownload}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="White"
                    CornerRadius="8"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="380">
                <StackPanel>
                    <TextBlock Text="模型文件未找到"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="当前选择的模型尚未安装。"
                               Foreground="#666666"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"
                               MaxWidth="340" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="从魔塔下载"
                                Width="110"
                                Height="32"
                                Margin="0,0,12,0"
                                Command="{Binding DownloadModelCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadSupported}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="知道了"
                                Width="80"
                                Height="32"
                                IsCancel="True"
                                Command="{Binding DismissDownloadPromptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
