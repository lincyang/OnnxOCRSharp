<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Settings -->
    <PackageId>OnnxOCRSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>程序员Linc</Authors>
    <Company>程序员Linc</Company>
    <Description>基于 ONNX Runtime + OpenCvSharp 的纯 .NET OCR 库，支持 PP-OCRv6 tiny / small / medium 模型。</Description>
    <PackageTags>OCR;ONNX;PP-OCRv6;PaddleOCR;TextRecognition</PackageTags>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lincyang/OnnxOCRSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lincyang/OnnxOCRSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CopyProjectReferencesToPackage">
    <ItemGroup>
      <_ReferencedProjectOutput Include="@(ProjectReference->'%(RootDir)%(Directory)bin\$(Configuration)\$(TargetFramework)\%(Filename).dll')" />
      <BuildOutputInPackage Include="@(_ReferencedProjectOutput)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\OnnxOcr.Core\OnnxOcr.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.26.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260528" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260528" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\NugetREADME.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
